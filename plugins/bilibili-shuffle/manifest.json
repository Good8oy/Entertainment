{
  "manifest_version": 3,
  "name": "Bilibili 乱序播放",
  "version": "1.1.0",
  "description": "在 Bilibili 播放页随机切换分 P、合集或番剧选集。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://www.bilibili.tv/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Bilibili 乱序播放",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*", "https://www.bilibili.tv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
